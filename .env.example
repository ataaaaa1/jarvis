# JARVIS ayarları (.env olarak kopyalayın)
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765
JARVIS_TOKEN=
JARVIS_ALLOW_SHELL=0
JARVIS_ALLOW_DANGEROUS=0
JARVIS_LANG=tr-TR
JARVIS_WAKE_WORD=jarvis
# --- LLM (opsiyonel) ---
JARVIS_LLM_PROVIDER=            # openai | ollama | anthropic
JARVIS_LLM_API_KEY=
JARVIS_LLM_BASE_URL=
JARVIS_LLM_MODEL=gpt-4o-mini
JARVIS_LLM_TIMEOUT=30
JARVIS_LLM_MAX_HISTORY=20
# --- Güvenlik / özellik ---
JARVIS_RATE_LIMIT=120
JARVIS_REQUIRE_CONFIRM=1
OPENWEATHER_API_KEY=
# Uygulama kısayolları: chrome=google-chrome,vscode=code
JARVIS_APPS=
# --- Telegram (opsiyonel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
